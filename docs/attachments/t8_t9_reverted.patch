diff --git a/ros_ws/src/follower_tracking/test/test_target_state.py b/ros_ws/src/follower_tracking/test/test_target_state.py
index be3ad86..69bc548 100644
--- a/ros_ws/src/follower_tracking/test/test_target_state.py
+++ b/ros_ws/src/follower_tracking/test/test_target_state.py
@@ -256,3 +256,71 @@ def test_negative_goal_distance_rotates():
     視野を変えにいく。
     """
     assert should_rotate_in_place(-0.42, ARRIVAL, 0, MAX_ABORTS) is True
+
+
+# ---------- 停止の検出 (DEVLOG T-8) ----------
+
+
+def test_stalled_with_a_failed_goal_rotates():
+    """動いておらず、かつゴールが失敗しているなら回転に切り替えること。
+
+    T-7 の abort 計数は 1 ゴールあたり 10 秒前後かかるため、
+    閾値 (3 回) に達するまで 35 秒も静止していた実測がある。
+    abort 1 回 + 停止なら、その時点で切り替える。
+    """
+    assert should_rotate_in_place(5.0, ARRIVAL, 1, MAX_ABORTS,
+                                  stalled=True) is True
+
+
+def test_stall_alone_does_not_cancel_a_working_goal():
+    """停止だけでは切り替えないこと。
+
+    停止判定は 3 秒で 0.05 m 未満 (= 0.017 m/s) と緩い。
+    Nav2 が低速で動き出す途中 (加速中・その場旋回中) を誤判定して
+    ゴールをキャンセルすると、正常な走行を邪魔する。
+    """
+    assert should_rotate_in_place(5.0, ARRIVAL, 0, MAX_ABORTS,
+                                  stalled=True) is False
+
+
+def test_not_stalled_keeps_driving():
+    assert should_rotate_in_place(5.0, ARRIVAL, 0, MAX_ABORTS,
+                                  stalled=False) is False
+
+
+def test_many_aborts_rotate_even_without_stall_detection():
+    """停止を検出できなくても、abort が積もれば切り替わること (T-7)。"""
+    assert should_rotate_in_place(5.0, ARRIVAL, MAX_ABORTS, MAX_ABORTS,
+                                  stalled=False) is True
+
+
+def test_stalled_defaults_to_false_for_backward_compatibility():
+    """引数を省略しても従来どおりの判定になること。"""
+    assert should_rotate_in_place(5.0, ARRIVAL, 0, MAX_ABORTS) is False
+    assert should_rotate_in_place(0.1, ARRIVAL, 0, MAX_ABORTS) is True
+
+
+# ---------- SEARCHING のゴールにスタンドオフを取らない (DEVLOG T-9) ----------
+
+
+def test_searching_goal_distance_is_to_the_target_itself():
+    """SEARCHING の前進判定は最終既知位置までの距離で行うこと。
+
+    手前 follow_distance を狙うと、見失った時点で対象が
+    follow_distance より近かった場合にゴールが自分の後ろに生まれ、
+    「到達済み」と判定されて永久に回転する
+    (実測: 推定距離 0.8 m のまま SEARCHING が 36 % を占めた)。
+
+    見失っている以上そこに相手はいないので、手前で止まる理由が無い。
+    最終既知位置そのものへ向かうほうが再検出の確率が高い。
+    """
+    last_known = 0.8      # 追従距離 1.0 より近い
+    # スタンドオフを引くと負になり「到達済み」= 回転
+    assert should_rotate_in_place(last_known - 1.0, ARRIVAL, 0, MAX_ABORTS) is True
+    # 対象までの距離そのものなら前進できる
+    assert should_rotate_in_place(last_known, ARRIVAL, 0, MAX_ABORTS) is False
+
+
+def test_searching_still_rotates_once_the_last_known_point_is_reached():
+    """最終既知位置へ着いても見つからなければ回転すること。"""
+    assert should_rotate_in_place(0.2, ARRIVAL, 0, MAX_ABORTS) is True
